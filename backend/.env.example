# Boxli Hub backend environment
BOXLI_ADDR=127.0.0.1:3727
BOXLI_DB=postgres://boxli:boxli@127.0.0.1:5432/boxli_hub?sslmode=disable
BOXLI_DATA_DIR=./data

# Auth（阶段 4 使用）
BOXLI_JWT_SECRET=change-me
BOXLI_GITHUB_CLIENT_ID=
BOXLI_GITHUB_SECRET=
# 必须与 GitHub OAuth App 登记的 Authorization callback URL **完全一致**，
# 否则 /auth/callback 换 token 时 GitHub 返回 redirect_uri_mismatch。
# 本项目 App 已登记：http://127.0.0.1:3727/api/v1/auth/callback（复测通过）。
BOXLI_GITHUB_REDIRECT=http://127.0.0.1:3727/api/v1/auth/callback
BOXLI_SESSION_TTL_HOURS=720

# ---- 阶段 4：回调落点、Cookie 与 CSRF ----

# OAuth 成功后 302 回跳的前端站点，同时作为写接口的 CSRF 来源白名单。
# 前端 OAuth 必须经该站点同源代理发起（localhost:3000/api/** → 127.0.0.1:3727）。
BOXLI_FRONTEND_URL=http://localhost:3000

# 会话 Cookie 是否带 Secure 属性。生产 HTTPS 必须 true；
# 本地 http://localhost 必须 false，否则浏览器丢弃 Cookie，表现为「登录后仍显示未登录」。
BOXLI_COOKIE_SECURE=false

# 额外允许的跨站来源（逗号分隔），仅用于多域名/CI 场景，默认只信任 BOXLI_FRONTEND_URL。
BOXLI_EXTRA_ORIGINS=

# ⚠️ 模拟登录后门：开启后 POST /auth/login 传 {"github_user":"x"} 即可登录为任意账号。
# 仅限本地开发调试，生产环境必须保持关闭（默认即关闭）。
BOXLI_DEV_LOGIN=0
